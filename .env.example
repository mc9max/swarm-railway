# ── Required for agents to actually respond ──────────────────────────────
# Bots need at least one provider key to reply. Get one at https://console.groq.com
# (free tier works), or add providers in the UI: Command Center → AI providers.
# For a zero-key demo with mock replies, set SWARM_DEMO=1 instead.
GROQ_API_KEY=

# Optional — overrides every agent's model column (e.g. openai/gpt-oss-120b)
SWARM_AGENT_MODEL=
# Optional — used if Groq fails or GROQ_API_KEY is unset
OPENROUTER_API_KEY=
# Optional — OpenRouter model slug; defaults to a mapped Groq name
OPENROUTER_MODEL=

# ── Optional: additional providers (Command Center → AI providers) ───────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=
TOGETHER_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
NVIDIA_API_KEY=
OPENCODE_API_KEY=
ZEN_API_KEY=

# ── Optional: bring your own OpenAI-compatible server (Ollama, LM Studio, vLLM) ──
# The "Custom (OpenAI-compatible)" provider uses this base URL.
SWARM_OPENAI_COMPAT_BASE_URL=
SWARM_OPENAI_COMPAT_API_KEY=

# ── Optional: web research / crawl tools (Computer → Apps) ───────────────
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# ── Optional: Composio app integrations (Gmail, Slack, GitHub, Notion…) ──
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=swarm-workspace

# ── Runtime ──────────────────────────────────────────────────────────────
# 1 = deterministic mock replies + seeded #general thread; no provider keys needed
SWARM_DEMO=
# 0 disables Playwright browser-use tools
SWARM_BROWSER=1
# 1 = bots may run tools on the host, bound to SWARM_SYSTEM_ROOT. Do NOT set
# the root to / unless you also set SWARM_SYSTEM_UNRESTRICTED=1.
SWARM_SYSTEM=1
# Secret used for signing sessions; leave blank to auto-generate
SWARM_SECRET=

# ── Optional: observability (Langfuse) ───────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=